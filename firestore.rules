rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isActive() {
      return isSignedIn() && userDoc().disabled != true;
    }

    match /users/{userId} {
      // Qualquer utilizador autenticado pode ler o seu próprio perfil (para
      // verificar se está desativado); o admin pode ler todos.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Só o admin pode criar/editar perfis (criação de utilizadores, desativação).
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /costumes/{costumeId} {
      allow read: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      // O admin também apaga (ao "apagar" um utilizador, os trajes dele são removidos).
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Pets: mesma estrutura dos trajes (itens e secções próprios; as personagens são partilhadas com os trajes).
    match /pets/{petId} {
      allow read: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /petSections/{sectionId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isActive() && resource.data.ownerUid == request.auth.uid;
    }

    match /sections/{sectionId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isActive() && resource.data.ownerUid == request.auth.uid;
    }

    match /characters/{characterId} {
      // O admin lê todas (para contar as personagens de cada conta).
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isActive() && resource.data.ownerUid == request.auth.uid;
    }

    // Timers de Biologo / 6-7 (máx. 2 por personagem, validado na app).
    match /bioTimers/{timerId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Guilds de doações (medalhas): cada utilizador só vê e mexe nas suas. Os limites
    // (2 guilds, 90 personagens por guild) são verificados na app.
    match /guilds/{guildId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /guildAccounts/{accountId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /guildCharacters/{characterId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.medals is int && request.resource.data.medals >= 0;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.medals is int && request.resource.data.medals >= 0;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Registo de Hidras (por utilizador): cada um só vê e mexe nos seus. As regras de "só se
    // editam hoje e ontem" são verificadas na app.
    match /hydraDays/{dayId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /hydraMonths/{monthId} {
      allow read: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /hydraTimers/{uid} {
      allow read, write: if isActive() && request.auth.uid == uid;
    }

    match /hydraSettings/{uid} {
      allow read, write: if isActive() && request.auth.uid == uid;
    }

    // Registo de Meley/Balathor (um por conta) — só o próprio dono lê/escreve.
    match /registrations/{uid} {
      allow read, write: if isActive() && request.auth.uid == uid;
    }

    // Preferências de notificação (Discord User ID, limiar de aviso) — só o
    // próprio dono lê/escreve. O Cloudflare Worker lê isto com credenciais de
    // serviço (Admin), que ignoram estas regras por completo.
    match /userSettings/{uid} {
      allow read, write: if isActive() && request.auth.uid == uid;
    }
  }
}
